# ============================================================
# SparkProcess — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ---- AWS Bedrock -----------------------------------------------
# Region where your Bedrock models are enabled
AWS_REGION=us-east-1

# Optional: explicit AWS credentials (leave blank to use IAM role / AWS CLI profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cross-region inference profile ID (recommended for production)
# Find IDs at: https://docs.aws.amazon.com/bedrock/latest/userguide/cross-region-inference.html
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# ---- AWS DynamoDB (AgentCore memory store) --------------------
DYNAMODB_TABLE_NAME=spark-process-memory
# Leave empty for real AWS; set to http://localhost:8001 for local DynamoDB
DYNAMODB_ENDPOINT_URL=

# ---- Datadog LLM Observability --------------------------------
DD_API_KEY=your-datadog-api-key
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=spark-process
DD_ML_APP=double-diamond-agents
DD_LLM_OBS_ENABLED=true

# ---- API Server -----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Agent behaviour ------------------------------------------
MAX_TOKENS_PER_AGENT=2048
AGENT_TEMPERATURE=0.7
# Set to true for strict security enforcement (rejects > 60 risk score)
SECURITY_STRICT_MODE=false

# ---- Frontend -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
